{
  "name": "@furifont/helper-web",
  "type": "module",
  "version": "0.6.2",
  "description": "Set the Japanese text of any web page in Furifont, leaving Latin, icon and code fonts alone",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/antfu/furifont#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/furifont.git",
    "directory": "packages/helper-web"
  },
  "bugs": "https://github.com/antfu/furifont/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./iife": "./dist/index.iife.js"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "turbo run build --filter=@furifont/helper-web"
  },
  "dependencies": {
    "@furifont/core": "workspace:*"
  }
}
