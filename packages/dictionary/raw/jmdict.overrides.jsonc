// Curated overrides of JMdict's readings, in inline notation: each is added as
// a row of JMdict and pins its reading as the default. JMdict's frequency tags
// belong to a written form, so across entries they cannot tell two readings
// apart; and a form that drops its okurigana usually meets it in running text,
// where the font cannot see it. A kanji run with no reading is left bare when
// alone in a run, though one reading dominates: the reading depends on the word
// around it, which a font cannot see past the run. Users' pins override these.
// Add entries with `pnpm dict:override`.
[
  // 出来る, 出来た: しゅったい is rare.
  "出[で]来[き]",
  // なにびと is literary.
  "何[なん]人[にん]",
  // いつ is mostly written in kana.
  "何[なん]時[じ]",
  // The date; みそか is the last day of a month.
  "三[さん]十[じゅう]日[にち]",
  // Nearly always written 外付け.
  "外[そと]付[づ]",
  // 支払い, 支払う.
  "支[し]払[はら]",
  // Alone, 字 is a character; あざ is a village section and ranks higher. A run
  // of kanji never includes the kana before it, so ローマ字 reaches the font as 字.
  "字[じ]",
  // 明朝体 is read みんちょう; みょうちょう is the dynasty's old reading.
  "明[みん]朝[ちょう]",
  // 月 is つき in a poem and がつ in a date.
  "月",
  "日",
  "年",
  // 白浪 is しらなみ (white waves, a thief; 白浪物); はくろう is the rare literary reading.
  // reported by 中院凛音 b42bf3c9-ffbd-4d24-bb86-c46dde64acd6
  "白[しら]浪[なみ]",
  // The shogun is read みなもとのよりとも, with の after the clan name 源.
  // reported by anonymous 8c2df88c-4638-4d31-b9c8-905e90635e98
  "源[みなもとの]頼[より]朝[とも]",
  // Alone, 凪 is なぎ (a calm; also a given name); JMdict has only な, from 凪ぐ.
  "凪[なぎ]",
  // 再掲載 is read さいけいさい; the font left 載 without a reading.
  // reported by ささ 12169a85-50db-44dc-a1ad-57a218f8a0f0
  "再[さい]掲[けい]載[さい]",
  // 合字 is a ligature; it ranks too low to be in the prebuilt set.
  "合[ごう]字[じ]",
  // 上側 is うわがわ in dictionaries; the font showed うわかわ, the first-listed form. うえがわ is common in speech but not a dictionary reading.
  "上[うわ]側[がわ]",
  // 関数 ranks too low to be in the prebuilt set.
  "関[かん]数[すう]",
  // 親要素 (parent element) ranks too low to be in the prebuilt set.
  "親[おや]要[よう]素[そ]",
  // 実装 (implementation) ranks too low to be in the prebuilt set.
  "実[じっ]装[そう]",
  // Alone, 編 is へん (編集, 前編); あ comes only from 編む, whose okurigana a font cannot see.
  "編[へん]",
  // あおやま (Aoyama, the surname and place) is far more common than せいざん.
  // reported by anonymous ce8c10c5-de07-4028-bb81-c290b7f0149a
  "青[あお]山[やま]",
  // 行 is い, おこな, ぎょう or ゆ by its okurigana, which a font cannot see.
  // reported by anonymous 73bacebb-b9f8-4a14-ae9e-7ec3272ff9fd
  // reported by anonymous cf8a1126-6d02-4370-8f8f-9840123af677
  // reported by anonymous 7673fc47-ab9d-48ac-9f79-881281e8ee83
  // reported by anonymous b07cdc6a-7eb2-4c10-a470-07fa0cf54f4d
  "行",
  // かな and かめい are both common and the okurigana does not tell them apart; 送り仮名 is おくりがな.
  // reported by 山下純司 c5638be5-66e8-48dd-bdaa-5be136faab2e
  // reported by anonymous 180738e7-2945-4f22-a7a5-e6743be597ae
  // reported by anonymous 6043fced-0c26-4b49-b981-1f81bb51054f
  // reported by anonymous bad2d58f-a880-492f-9382-6ef4bef97a7a
  // reported by anonymous 8e6cc4ae-0cdf-4b27-a5ed-6540d2056092
  "仮名",
  // 枝垂れ is しだれ: the れ is okurigana, so the kanji read し and だ.
  // reported by momosu 226ad245-7b96-4964-a432-9f1a30b59344
  "枝[し]垂[だ]",
  // A lone 裡 is うち (夢の裡に).
  // reported by momosu 226ad245-7b96-4964-a432-9f1a30b59344
  "裡[うち]",
  // A lone 糧 is かて (心の糧).
  // reported by 1201o df875bcd-c1d6-4541-9caf-4c18bc5c2779
  "糧[かて]",
  // 太郎冠者 (kyogen role) is たろうかじゃ.
  // reported by Mafuyu db88ae0b-39e9-4ef0-9089-0c933796a0f7
  "太[た]郎[ろう]冠[か]者[じゃ]",
  // 今日庵 (Urasenke tea house) is こんにちあん.
  // reported by Mafuyu 309d8cea-c3b2-444c-ad55-afc110a27781
  "今[こん]日[にち]庵[あん]",
  // 今日性 is こんにちせい.
  // reported by Mafuyu 8a996236-0807-418a-ace5-3f83d0ed5c26
  "今[こん]日[にち]性[せい]",
  // 攫う is さらう; つか is rare.
  // reported by momosu 226ad245-7b96-4964-a432-9f1a30b59344
  "攫[さら]",
  // 嗚呼 is ああ.
  // reported by momosu 226ad245-7b96-4964-a432-9f1a30b59344
  "嗚[あ]呼[あ]",
  // 眼差し is まなざし.
  // reported by 1201o df875bcd-c1d6-4541-9caf-4c18bc5c2779
  "眼[まな]差[ざ]",
  // 最推し (a fan's favourite) is さいおし.
  // reported by 1201o df875bcd-c1d6-4541-9caf-4c18bc5c2779
  "最[さい]推[お]",
  // 何回目 is なんかいめ.
  // reported by 1201o df875bcd-c1d6-4541-9caf-4c18bc5c2779
  "何[なん]回[かい]目[め]",
  // 鬼遣らい is おにやらい (the exorcism rite).
  // reported by Mafuyu 44af4ee0-5563-4936-8848-aa241355bc58
  "鬼[おに]遣[や]",
  // 今日主義 is こんにちしゅぎ (Daijisen).
  // reported by Mafuyu 775ebe1f-bc5f-4c73-b397-2df0ee981d97
  "今[こん]日[にち]主[しゅ]義[ぎ]",
  // 今日新聞 (Beppu newspaper) is こんにちしんぶん.
  // reported by Mafuyu 99898e09-fee9-43d8-b2ef-35f9d1af614b
  "今[こん]日[にち]新[しん]聞[ぶん]",
  // 今日只今 is こんにちただいま (Weblio).
  // reported by Mafuyu 83e73648-d757-4564-b509-5fbe6ce9c823
  "今[こん]日[にち]只[ただ]今[いま]",
  // 今日唯今 is こんにちただいま (Weblio).
  // reported by Mafuyu faea8d32-c478-4652-a8ce-4dcc0d0c296b
  "今[こん]日[にち]唯[ただ]今[いま]",
  // 無題 is read むだい; the word fell outside the prebuilt fonts, so only だい showed.
  // reported by anonymous d4ae0364-639c-4847-a2e0-6210336cfc3a
  "無[む]題[だい]"
]
