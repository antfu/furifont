{
  "name": "@furifont/dictionary",
  "type": "module",
  "version": "0.3.0",
  "description": "JMdict words aligned with per-kanji readings, compiled for Furifont",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://github.com/antfu/furifont#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/furifont.git",
    "directory": "packages/dictionary"
  },
  "bugs": "https://github.com/antfu/furifont/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./okurigana": "./dist/okurigana.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE.md",
    "data",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "turbo run build --filter=@furifont/dictionary",
    "update": "node scripts/update.ts",
    "update:manual": "node scripts/jr-stations.ts && node scripts/yojijukugo.ts",
    "audit": "node scripts/audit.ts"
  },
  "dependencies": {
    "@furifont/core": "workspace:*",
    "valibot": "catalog:prod"
  },
  "devDependencies": {
    "@furifont/compiler": "workspace:*"
  }
}
