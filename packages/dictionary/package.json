{
  "name": "@furifont/dictionary",
  "type": "module",
  "version": "0.6.1",
  "description": "JMdict, JMnedict and hand-kept word lists fused by the Han runs a font sees, compiled for Furifont",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://github.com/antfu/furifont#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/furifont.git",
    "directory": "packages/dictionary"
  },
  "bugs": "https://github.com/antfu/furifont/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE.md",
    "data",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/compile.ts && tsdown",
    "prepack": "turbo run build --filter=@furifont/dictionary",
    "compile": "node scripts/compile.ts",
    "update": "node scripts/update.ts",
    "update:manual": "node scripts/manual/jr-stations.ts && node scripts/manual/yojijukugo.ts && node scripts/manual/japan-post.ts",
    "audit": "node scripts/audit.ts",
    "lookup": "node scripts/lookup.ts",
    "override": "node scripts/override.ts"
  },
  "dependencies": {
    "@furifont/core": "workspace:*",
    "valibot": "catalog:prod"
  },
  "devDependencies": {
    "@furifont/compiler": "workspace:*",
    "@furifont/helper-web": "workspace:*"
  }
}
