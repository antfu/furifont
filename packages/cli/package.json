{
  "name": "furifont",
  "type": "module",
  "version": "0.0.0",
  "description": "Build Japanese fonts that show furigana by themselves, from the command line or a local studio",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/antfu/furigana-font#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/furigana-font.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/antfu/furigana-font/issues",
  "keywords": [
    "font",
    "furigana",
    "ruby",
    "japanese",
    "opentype",
    "devframe"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "furifont": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@furifont/compiler": "workspace:*",
    "@furifont/core": "workspace:*",
    "@furifont/dictionary": "workspace:*",
    "cac": "catalog:prod",
    "valibot": "catalog:prod"
  }
}
