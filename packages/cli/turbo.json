{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The app it generates inlines @furifont/helper-web's build, which the CLI does not import.
      "dependsOn": ["^build", "@furifont/helper-web#build"],
      // The build also generates the app and copies it into dist/client, so those count as inputs.
      "inputs": ["$TURBO_DEFAULT$", "../app/app/**", "../app/server/**", "../app/shared/**", "../app/public/**", "../app/nuxt.config.ts", "../app/uno.config.ts", "../dictionary/data/okurigana.json"],
      "outputs": ["dist/**", "../app/.output/**"]
    }
  }
}
