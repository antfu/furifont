{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "paths": {
      "@furifont/core": ["./packages/core/src/index.ts"],
      "@furifont/compiler": ["./packages/compiler/src/index.ts"],
      "@furifont/compiler/node": ["./packages/compiler/src/node.ts"],
      "@furifont/dictionary": ["./packages/dictionary/src/index.ts"],
      "furifont": ["./packages/cli/src/index.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/scripts", "packages/*/*.ts", "scripts", "test", "*.ts"],
  "exclude": ["packages/app"]
}
