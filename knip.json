{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@antfu/utils",
    "taze",
    "@antfu/skills"
  ],
  "workspaces": {
    ".": {
      // Vercel Functions: Vercel deploys every file in api/.
      "entry": ["api/*.ts"]
    },
    "packages/*": {},
    "packages/app": {
      "storybook": true,
      "ignoreDependencies": [
        "@iconify-json/ph",
        "vue-tsc"
      ]
    }
  }
}
